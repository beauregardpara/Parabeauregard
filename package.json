{
  "name": "para-beauregard",
  "version": "1.0.0",
  "private": true,
  "description": "Para Beauregard — Plateforme e-commerce parapharmacie (Maroc) : site vitrine, panel admin, scraper multi-sources, assistant IA.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run clean && node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "serve:auto": "node scripts/auto-serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "prisma:validate": "node scripts/prisma.mjs validate",
    "db:export:sqlite": "tsx scripts/export-sqlite.ts",
    "db:import:postgres": "tsx scripts/import-postgres.ts",
    "db:migrate:data": "tsx scripts/import-postgres.ts",
    "db:backup:postgres": "tsx scripts/backup-postgres.ts",
    "db:backup:remote": "node scripts/backup-postgres-remote.mjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "db:seed": "tsx prisma/seed.ts",
    "scrape": "tsx src/scripts/run-scrape.ts",
    "scrape:schedule": "tsx src/scripts/schedule-scrape.ts",
    "enrich": "tsx src/scripts/enrich-products.ts",
    "test:firecrawl": "tsx scripts/test-firecrawl.ts",
    "images:swap": "node scripts/swap-images.mjs",
    "postinstall": "node scripts/prisma.mjs generate",
    "deployment:preflight": "node scripts/production-preflight.mjs",
    "brands:normalize": "tsx src/scripts/normalize-brands.ts",
    "seed:demo": "tsx src/scripts/seed-demo-content.ts",
    "start:standalone": "node scripts/start-standalone.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@mendable/firecrawl-js": "^4.38.0",
    "@prisma/client": "^6.5.0",
    "cheerio": "^1.0.0",
    "lucide-react": "^1.40.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
