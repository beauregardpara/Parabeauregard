# Para Beauregard — variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez-le. NE COMMITTEZ JAMAIS de vraie valeur :
# ce fichier ne doit contenir que des placeholders.

# --- Base de données (obligatoire) ---
# Connexion applicative (pooler Supabase en production).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Connexion directe (migrations, pg_dump).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Sessions (obligatoire en production) ---
# Générer avec : openssl rand -hex 32
SESSION_SECRET="remplacez-par-un-secret-aleatoire-en-prod"
# Laisser vide en production (les cookies sécurisés sont déduits de l'URL HTTPS).
SESSION_COOKIE_SECURE=""

# --- URL publique (obligatoire en production) ---
# Source unique de vérité SEO/emails, lue via src/config/site.ts.
# Doit être en HTTPS et sans slash final. Passer au domaine personnalisé ici.
NEXT_PUBLIC_SITE_URL="https://para-beauregard.vercel.app"
APP_VERSION="1.1.1"
# `true` derrière le proxy Vercel (confiance à X-Forwarded-For).
TRUSTED_PROXY="true"

# --- Supabase Storage (images produits) ---
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Clé serveur UNIQUEMENT. Ne jamais exposer côté client.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"

# --- Emails transactionnels (optionnel : sans clé, envoi no-op journalisé) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# L'expéditeur doit appartenir à un domaine vérifié dans Resend.
RESEND_FROM="Para Beauregard <commandes@VOTRE-DOMAINE>"
# Adresse de réponse par défaut (sinon l'email public de src/config/business.ts).
MAIL_REPLY_TO=""
# Destinataire des notifications internes (nouvelles commandes, contact).
BUSINESS_NOTIFICATION_EMAIL=""
# `disabled` coupe complètement l'envoi d'emails.
EMAIL_FROM=""

# --- Firecrawl (analyse de réputation, serveur uniquement) ---
FIRECRAWL_API_KEY="fc-xxxxxxxxxxxxxxxxxxxx"
REPUTATION_ENABLED="true"
REPUTATION_CACHE_DAYS="7"
REPUTATION_MAX_SEARCH_RESULTS="5"

# --- Sauvegardes (utilisées par .github/workflows/database-backup.yml) ---
# Secrets GitHub, pas des variables locales : SUPABASE_DB_URL, SUPABASE_URL, SUPABASE_SECRET_KEY.
SUPABASE_BACKUP_BUCKET="database-backups"
SUPABASE_STORAGE_BACKUP_BUCKET="product-images"
BACKUP_RETENTION_DAYS="14"

# --- Seed administrateur (scripts locaux uniquement) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
ADMIN_ROLE=""

# --- Observabilité (optionnel) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="info"
